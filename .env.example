# Recruitment Quality Intelligence — environment template
# Copy to apps/web/.env.local for local development. No real values belong in
# this file or in git history. Every variable here is read through the
# validated env accessor (apps/web/lib/env.ts) — see docs/21-implementation-contract.md §21.6.
#
# NOTHING in this Build Phase 1 scaffold actually reads secrets yet: no Supabase
# client, no Claude client, no Resend client, no Sentry init is wired up. This
# file exists now so the shape is right when Phase 2+ wires those in, and so
# the demo-mode contract below is testable from day one.

# --- Public (safe to expose to the browser; NEXT_PUBLIC_ prefix only) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Build Phase 15 Wave 3: monitoring/error tracking (docs/monitoring-runbook.md) ---
# SENTRY_DSN (server/edge) and NEXT_PUBLIC_SENTRY_DSN (browser) should be set
# to the SAME DSN value once a real Sentry project exists — a DSN is a
# public, non-secret identifier by Sentry's own design. Leave BOTH blank for
# local dev and in this environment today (no Sentry project has ever been
# created here) — lib/env.ts's `sentryConfigured` is then false and every
# Sentry.init() call and lib/monitoring/capture.ts helper is a safe no-op.
NEXT_PUBLIC_SENTRY_DSN=

# --- Build Phase 15 Wave 1: build/release identity ---
# Baked in at build time by .github/workflows/staging-deploy.yml only — never
# set for local development. Leave both blank locally; lib/env.ts's
# getBuildInfo() returns an honest "unknown" build identity when absent. See
# docs/rollback-runbook.md for how these are used to identify the live release.
NEXT_PUBLIC_BUILD_SHA=
NEXT_PUBLIC_RELEASE_TAG=

# --- Build Phase 15 Wave 2: environment identity, staging access, staging
# storage/AI-cost overrides ---
# NEXT_PUBLIC_ENVIRONMENT_NAME: leave blank for local dev. The staging Vercel
# project should set this to exactly `staging` (shows the non-production
# banner, components/domain/non-production-banner.tsx). Never set it to
# `production` here or anywhere else until a real production posture is
# decided — the banner also stays hidden for that value, but nothing in this
# codebase currently treats `production` as meaningfully different from
# unset elsewhere.
NEXT_PUBLIC_ENVIRONMENT_NAME=

# STAGING_BASIC_AUTH_USER / STAGING_BASIC_AUTH_PASSWORD: leave BOTH blank for
# local dev (the gate is then a no-op, proxy.ts). Set both on the staging
# Vercel project to put a shared-password HTTP Basic Auth wall in front of
# the whole staging deployment — a coarse "keep search engines and randos
# out" measure only, never a substitute for the app's own Supabase-Auth
# based sign-in, which still fully applies underneath it. See
# docs/staging-deployment.md.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# SUPABASE_STORAGE_BUCKET: leave blank to use the existing default
# ('documents'). A staging deployment should set this to a staging-only
# bucket name (e.g. `rqi-staging-documents`) that exists in the staging
# Supabase project, so seeded staging documents can never collide with a
# hypothetical production bucket. See lib/files/storage.ts.
SUPABASE_STORAGE_BUCKET=

# COPILOT_DAILY_MESSAGE_LIMIT / COPILOT_DAILY_COST_LIMIT_USD: leave blank to
# keep the existing defaults (200 messages/day, $5/day —
# lib/copilot/orchestration/run-copilot-turn.ts). Consider setting BOTH
# lower on staging to bound AI cost exposure when multiple UAT testers may
# be hammering the copilot at once.
COPILOT_DAILY_MESSAGE_LIMIT=
COPILOT_DAILY_COST_LIMIT_USD=

# --- Server-only (NEVER prefix with NEXT_PUBLIC_, never reaches the client bundle) ---
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
SENTRY_DSN=
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN: optional, enable build-time
# source-map upload via withSentryConfig (next.config.ts). Leave blank to
# still send events without minified/unmapped stack traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# SENTRY_TRACES_SAMPLE_RATE: leave blank to keep the default 0.1 (10%)
# performance-tracing sample rate (lib/env.ts).
SENTRY_TRACES_SAMPLE_RATE=

# --- Build Phase 12 Wave 3: optional integrations (lib/env.ts, same never-crash,
# optional-var treatment as everything else above — each *Configured flag is
# false, and the corresponding adapter returns a not-configured result,
# until real values are supplied) ---
APOLLO_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# --- Build Phase 12 Wave 4: system-notification email "from" identity ---
# Optional. Unset, lib/notifications/email-template.ts falls back to a
# clearly-labelled placeholder address rather than claiming a real one
# exists. Never a recruiter's own sending identity (see
# outreach_messages.sender_account_identifier for that, a different,
# per-message concern).
NOTIFICATIONS_FROM_EMAIL=

# --- Demo mode ---
# When the Supabase/Anthropic/Resend variables above are absent, the app runs
# in demo mode automatically: every screen renders against the centralized
# mock fixtures in apps/web/lib/mock-data.ts and no external call is attempted.
# This is not a separate flag to set — it is the natural behavior of an
# unconfigured environment, verified by lib/env.ts and covered by
# apps/web/lib/env.test.ts.

# --- Build Phase 2: authentication ---
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY (above) are what
# lib/env.ts's `supabaseConfigured` flag checks. Until both are set:
#   - proxy.ts (formerly middleware.ts) does not enforce authentication (there is no session to
#     check), and says so via the `x-rqi-auth-enforced: false` response
#     header rather than silently pretending routes are protected;
#   - the sign-in/forgot-password/reset-password screens render a clear
#     "authentication is not configured" state instead of a broken form.
# SUPABASE_SERVICE_ROLE_KEY is required only for apps/web/scripts/seed.ts
# (creating the demo users) and lib/supabase/admin.ts (server-only,
# platform-admin operations) — it is never read by any client-side code path.
# No Supabase project has been created or connected for this repository; see
# docs/build-phase-2-report.md for exactly what remains a blocker until one
# is provisioned and its URL/keys are supplied.
